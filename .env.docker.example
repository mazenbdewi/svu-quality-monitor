APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_PORT=8080

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change_this_database_password
DB_ROOT_PASSWORD=change_this_root_password

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file

QUEUE_CONNECTION=database
MONITORING_FIXED_CADENCE_ENABLED=false
SLO_AUTO_PREPARATION_ENABLED=false
BASELINE_PREPARATION_BACKLOG_LIMIT=25
BASELINE_PREPARATION_BACKLOG_WARNING=20
BASELINE_PREPARATION_OLDEST_WARNING_SECONDS=3600
BASELINE_PREPARATION_STARTUP_GRACE_SECONDS=180

FILESYSTEM_DISK=local
